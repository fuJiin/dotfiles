#!/bin/bash
{{ if eq .chezmoi.os "darwin" -}}
set -euo pipefail

# The Brewfile is rendered inline below, so this script's content hash changes
# whenever the package list -- or the `personal` flag -- changes. That is what
# makes run_onchange re-run it, so no separate sha256sum marker is needed.
brewfile="$(mktemp)"
trap 'rm -f "$brewfile"' EXIT

cat > "$brewfile" <<'CHEZMOI_BREWFILE_EOF'
{{ template "Brewfile" . }}
CHEZMOI_BREWFILE_EOF

brew bundle --file="$brewfile"
{{ end -}}
