# Generated by chezmoi. Identity comes from ~/.config/chezmoi/chezmoi.toml,
# which is per-machine and NOT tracked in this repo.
[user]
	name = {{ .git.name }}
	email = {{ .git.email }}
[init]
	defaultBranch = main
{{ if eq .chezmoi.os "darwin" -}}
[credential]
	helper = osxkeychain
{{ end -}}
{{ if and .git.workDir .git.workEmail }}
# Work repos use a separate identity; see ~/.gitconfig-work
[includeIf "gitdir:{{ .git.workDir }}"]
	path = ~/.gitconfig-work
{{- end }}
