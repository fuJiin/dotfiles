#!/bin/bash
# Read existing settings from stdin, merge statusLine config
input=$(cat)
if [ -z "$input" ] || [ "$input" = "{}" ]; then
    input='{}'
fi
# Strip the terminal-notifier hooks this file used to install. They failed on
# every turn once macOS notifications were off for terminal-notifier, and
# Claude Code's own notifications cover the same ground. Hooks added by other
# means are left alone.
echo "$input" | jq '
  if .hooks then
    .hooks |= (with_entries(.value |= map(select(any(.hooks[]?; .command? // "" | test("terminal-notifier")) | not)))
               | with_entries(select(.value | length > 0)))
    | if .hooks == {} then del(.hooks) else . end
  else . end
  + {
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  }
}'
