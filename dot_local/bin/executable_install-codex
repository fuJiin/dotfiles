#!/bin/bash
set -euo pipefail

if command -v codex &>/dev/null; then
    if [[ "${1:-}" != "--upgrade" ]]; then
        exit 0
    fi
fi

os="$(uname -s)"
arch="$(uname -m)"

case "$os:$arch" in
    Darwin:arm64|Darwin:aarch64)
        asset="codex-aarch64-apple-darwin.tar.gz"
        binary="codex-aarch64-apple-darwin"
        ;;
    Darwin:x86_64)
        asset="codex-x86_64-apple-darwin.tar.gz"
        binary="codex-x86_64-apple-darwin"
        ;;
    Linux:x86_64|Linux:amd64)
        asset="codex-x86_64-unknown-linux-musl.tar.gz"
        binary="codex-x86_64-unknown-linux-musl"
        ;;
    Linux:arm64|Linux:aarch64)
        asset="codex-aarch64-unknown-linux-musl.tar.gz"
        binary="codex-aarch64-unknown-linux-musl"
        ;;
    *)
        echo "Unsupported platform for Codex: $os/$arch" >&2
        exit 1
        ;;
esac

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

curl -fsSL "https://github.com/openai/codex/releases/latest/download/$asset" \
    -o "$tmpdir/$asset"
tar -xzf "$tmpdir/$asset" -C "$tmpdir"

mkdir -p "$HOME/.local/bin"
install -m 0755 "$tmpdir/$binary" "$HOME/.local/bin/codex"
