#!/bin/bash
{{ if eq .chezmoi.os "darwin" -}}
set -euo pipefail

# The Brewfile is rendered inline below, so this script's content hash changes
# whenever the package list -- or the `personal` flag -- changes. That is what
# makes run_onchange re-run it, so no separate sha256sum marker is needed.
{{ template "brew-shellenv" . }}

brewfile="$(mktemp)"
trap 'rm -f "$brewfile"' EXIT

cat > "$brewfile" <<'CHEZMOI_BREWFILE_EOF'
{{ template "Brewfile" . }}
CHEZMOI_BREWFILE_EOF

# Recent Homebrew refuses to load formulae from third-party taps until they are
# explicitly trusted, which would make the first `brew bundle` on a new machine
# fail on emacs-plus. Trust every tap the Brewfile declares, rather than leaving
# it as a manual pre-step in the README.
if command -v brew &> /dev/null && brew trust --help &> /dev/null; then
    sed 's/#.*//' "$brewfile" \
        | grep -oE '^[[:space:]]*tap "[^"]+"' \
        | grep -oE '"[^"]+"' | tr -d '"' \
        | while read -r tap; do
            brew trust "$tap" || echo "WARN: could not trust tap $tap"
        done
fi

brew bundle --file="$brewfile"
{{ end -}}
