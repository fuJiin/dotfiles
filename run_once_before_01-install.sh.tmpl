#!/bin/bash
set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
# Load brew's PATH *before* testing whether it is installed. chezmoi runs this
# in a non-login shell, so an existing Homebrew is usually absent from PATH --
# testing first would re-run the installer, which then demands sudo and fails.
{{ template "brew-shellenv" . }}

# Install Homebrew
if ! command -v brew &> /dev/null; then
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Again, to pick up a Homebrew that the line above just installed.
{{ template "brew-shellenv" . }}

# Update Git, and install jq up front: this is a `before_` script precisely
# because modify_dot_claude/settings.json.tmpl pipes through jq while files are
# being applied, which happens long before run_onchange_after_02-brew-bundle.sh
# gets a chance to install it.
brew install git jq

{{ else if eq .chezmoi.os "linux" -}}
sudo apt-get update
sudo apt-get install -y \
    git \
    fish \
    tmux \
    curl \
    jq \
    ripgrep \
    fd-find \
    build-essential

# fd-find installs as fdfind on Ubuntu; symlink to fd
if command -v fdfind &> /dev/null && ! command -v fd &> /dev/null; then
    sudo ln -sf "$(command -v fdfind)" /usr/local/bin/fd
fi

# Set fish as default shell
if [ "$SHELL" != "$(command -v fish)" ]; then
    command -v fish | sudo tee -a /etc/shells
    sudo chsh -s "$(command -v fish)" "$(whoami)"
fi

{{ end -}}
# Configure SSH
# Use the work identity for the key comment when this machine has one.
{{ $sshEmail := .git.email -}}
{{ if .git.workEmail }}{{ $sshEmail = .git.workEmail }}{{ end -}}
if [ ! -f ~/.ssh/id_ed25519 ]; then
    ssh-keygen -t ed25519 -C "{{ $sshEmail }}" -N "" -f ~/.ssh/id_ed25519
    echo "NOTE: SSH key created without a passphrase. Add one with:"
    echo "      ssh-keygen -p -f ~/.ssh/id_ed25519"
fi
