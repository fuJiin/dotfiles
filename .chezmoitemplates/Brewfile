# === CROSS-PLATFORM ===

# Shell
brew "fish"
brew "tmux"          # ~/.tmux.conf is managed here; the `tmx` alias needs it

# Search
brew "ripgrep"
brew "fd"

# Git
brew "lazygit"
brew "gh"

# Dev tools
brew "worktrunk"
brew "chezmoi"       # manages this repo; the `cz` alias needs it
brew "jq"            # REQUIRED at apply time by modify_.claude/settings.json
                     # and at runtime by ~/.claude/statusline.sh

# AI agents
brew "gemini-cli"

# Cloud / Infra
brew "hcloud"

# Language runtimes
brew "pyenv"
brew "fnm"
brew "uv"            # used by ~/.config/imir/bake-hook.sh

# === macOS ONLY ===

if OS.mac?
  cask_args appdir: "/Applications"

  # Required by the Claude Code hooks in ~/.claude/settings.json
  brew "terminal-notifier"

  # Terminal
  cask "ghostty"

  # Editor
  # NOTE: third-party tap. Homebrew requires explicit trust before this
  # will install:  brew trust d12frosted/emacs-plus
  # native-comp is built in as of Emacs 29+, so no --with-native-comp arg.
  tap "d12frosted/emacs-plus"
  brew "emacs-plus"

  # Doom requires this for its icons (nerd-icons); without it `doom doctor`
  # warns and every icon renders as a placeholder box. Note that Symbola,
  # Emacs' unicode fallback font, is NOT in Homebrew -- install it by hand from
  # unicode.org if `doom doctor` complains about it.
  cask "font-symbols-only-nerd-font"
{{- if .personal }}

  # === PERSONAL MACHINES ONLY ===
  # Gated on `personal` in ~/.config/chezmoi/chezmoi.toml so work machines
  # never pull in consumer apps or hit an App Store sign-in prompt.

  cask "alfred"
  cask "1password"
  cask "macdown-3000"
  cask "rectangle"
  cask "spotify"

  # Keep system awake
  brew "mas"
  mas "Amphetamine", id: 937984704
{{- end }}
end
