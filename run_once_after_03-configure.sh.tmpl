#!/bin/bash
set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
{{ template "brew-shellenv" . }}

# Clone Doom Emacs if not present (macOS only - remote boxes use TRAMP).
# `doom install` byte-compiles by shelling out to emacs, so it cannot run
# before run_onchange_after_02-brew-bundle.sh has installed emacs-plus -- hence
# the `after_03` ordering, and the guard for the case where that build failed.
if [ ! -d ~/.emacs.d ]; then
    git clone --depth 1 https://github.com/doomemacs/doomemacs ~/.emacs.d
fi

# The install is deliberately NOT guarded on a path. The clone and the install
# are separate steps, so any guard that a half-finished install also satisfies
# ("~/.emacs.d exists", "straight/ exists") turns this into a permanent no-op
# with Doom never installed -- which is the trap the directory guard fell into.
#
# chezmoi already provides the right semantics: it records a run_once script
# only after it exits 0, so with `set -e` a failed install simply retries on the
# next apply. `doom install` is itself idempotent and skips what it has already
# done, so re-running costs little and is always safe.
if ! command -v emacs &> /dev/null; then
    # Not fatal: the box may be mid-emacs-plus build, or headless.
    echo "WARN: emacs not found, skipping Doom install."
    echo "      Install emacs-plus, then re-run: ~/.emacs.d/bin/doom install --force"
else
    # Both halves of this are load-bearing.
    #
    # --force suppresses the prompts (envvar file, fonts). But that alone is
    # NOT enough: doom still reads stdin, and chezmoi hands the script an
    # inherited stdin that never delivers and never closes, so the read blocks
    # forever. Measured, with everything else identical: stdin=/dev/null exits
    # 0 in ~2s, stdin=blocking-pipe hangs indefinitely and prints nothing.
    #
    # The failure mode is nasty because it does not look like a hang -- Emacs
    # sits in state S at 0.0% CPU with no output, which reads as a slow
    # native-comp build. It cost 37 minutes here before anyone checked %CPU.
    ~/.emacs.d/bin/doom install --force < /dev/null
fi

# emacs-plus leaves Emacs.app inside the Cellar and only prints a caveat about
# it, so a fresh machine has a working `emacs` CLI but nothing in Finder,
# Spotlight or the Dock -- which reads as "Emacs didn't install".
#
# Linked, not copied. Homebrew's caveat suggests `cp -r` for better Spotlight
# indexing, but a copy goes stale the moment emacs-plus is upgraded. The link
# points at the UNVERSIONED opt path, so it keeps following version bumps
# (emacs-plus@31 -> @32) with no action. Swap to `cp -r` if Spotlight matters
# more to you than staying current.
for app in "Emacs.app" "Emacs Client.app"; do
    src="$(brew --prefix)/opt/emacs-plus/$app"
    if [ -e "$src" ] && [ ! -e "/Applications/$app" ]; then
        ln -s "$src" "/Applications/$app"
    fi
done

# Ensure config directories exist
mkdir -p ~/.config/ghostty
{{ end -}}
